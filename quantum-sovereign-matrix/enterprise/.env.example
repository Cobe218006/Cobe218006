# Copy to .env and fill in real values. Never commit .env. Never paste any
# of these values into a chat, issue, or anywhere client-side — they belong
# only in your backend's environment/secret manager.

# --- Quantum execution (backend/proof_engine.py) ---
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_BACKEND=

# --- IPFS pinning (backend/pinning.py, used by POST /api/ipfs/pin) ---
PINATA_JWT=
# Leave unset in production. Only backend/tests/test_api.py sets this, to
# point pin_json() at a local fake server instead of the real Pinata API.
PINATA_BASE_URL=

# --- Blockchain anchoring ---
RPC_URL=
DEPLOYER_PRIVATE_KEY=

GENESIS_REGISTRY_ADDRESS=
GENESIS_REGISTRY_CHAIN_ID=

# --- Signing (keep this key only on your backend; master.html generates and
#     holds its own key client-side instead and never uses this variable) ---
ECDSA_PRIVATE_KEY_PEM=

# --- Public verification ---
PUBLIC_VERIFICATION_GATEWAY=https://dweb.link/ipfs/

# --- Sign In (POST /api/auth/google) ---
# Same Client ID you paste into master.html's "Links & Configuration" panel.
# This variable is what makes /api/auth/google's verification trustworthy —
# without it the endpoint refuses to check tokens at all (there would be no
# fixed audience to validate them against). Create this at
# https://console.cloud.google.com/apis/credentials as an OAuth 2.0 "Web
# application" client, with "Authorized JavaScript origins" including the
# gateways you expect master.html to be viewed from, e.g.:
#   https://dweb.link
#   https://ipfs.io
#   https://gateway.pinata.cloud
GOOGLE_OAUTH_CLIENT_ID=
