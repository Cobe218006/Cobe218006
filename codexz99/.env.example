# Copy to .env.local and fill in to use chain mode. Leave unset for local
# mode (a throwaway key persisted in this browser, no real chain).

# 'local' (default) or 'chain'
VITE_MODE=

# Required for chain mode: an EVM RPC endpoint (e.g. a Sepolia endpoint
# from Infura/Alchemy) and the deployed Registry.sol contract address.
VITE_RPC_URL=
VITE_CONTRACT_ADDRESS=
VITE_CHAIN_ID=11155111
