# Copy to .env (or export in your shell / process manager). Placeholders only — never commit real values.
# The npm scripts load ./.env automatically when it exists (node --env-file-if-exists).

NODE_ENV=development
PORT=3000

# SQLite database file (relational; migrations in ./migrations)
DATABASE_PATH=./data/oon.db

# Private document storage directory. MUST be outside any web-served directory.
DOCUMENT_STORAGE_DIR=./data/private-documents

# Secrets: required (>= 32 chars) when NODE_ENV=production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-64-hex-chars
DOCUMENT_LINK_SECRET=replace-with-a-different-64-hex-chars

# Short-lived document link lifetime (seconds) and session lifetime (hours)
DOCUMENT_LINK_TTL_SECONDS=300
SESSION_TTL_HOURS=12

# Upload limit in bytes (default 10 MB)
MAX_UPLOAD_BYTES=10485760

# Time zone used to DISPLAY timestamps (all timestamps are stored in UTC)
DISPLAY_TIME_ZONE=America/Chicago

# Set true behind HTTPS (default true in production)
COOKIE_SECURE=false

# Demo seed: allowed automatically outside production. Password for fictional demo accounts.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=replace-with-a-local-demo-password
